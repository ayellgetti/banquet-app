{
  "name": "banquet",
  "private": true,
  "version": "1.0.0",
  "description": "Banquet CRM monorepo — API and web app",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter './api' --filter './web' run dev",
    "dev:api": "pnpm --filter banquet-crm-api dev",
    "dev:web": "pnpm --filter banquet-web dev",
    "build": "pnpm -r --filter './api' --filter './web' run build",
    "build:api": "pnpm --filter banquet-crm-api build",
    "build:web": "pnpm --filter banquet-web build",
    "lint": "pnpm -r --filter './api' --filter './web' run lint",
    "test": "pnpm -r --filter './api' --filter './web' run test",
    "prisma:generate": "pnpm --filter banquet-crm-api prisma:generate",
    "prisma:migrate": "pnpm --filter banquet-crm-api prisma:migrate",
    "prisma:seed": "pnpm --filter banquet-crm-api prisma:seed",
    "prisma:studio": "pnpm --filter banquet-crm-api prisma:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
